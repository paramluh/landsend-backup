> def _flat(d, pre=""):
>     out = {}
>     for k, v in d.items():
>         if isinstance(v, dict):
>             out.update(_flat(v, f"{pre}{k}."))
>         else:
>             out[f"{pre}{k}"] = json.loads(json.dumps(v, default=str))
>     return out
> 
> 
> def cfg_diff():
>     ref = _flat(json.load(open(CFG["ref_cfg"])))
>     cur = _flat(json.loads(json.dumps(CFG, default=str)))
>     rows, bad = [], []
>     for k in sorted(set(ref) | set(cur)):
>         a, b = ref.get(k, "<absent>"), cur.get(k, "<absent>")
>         if k.startswith("eval_data.") and b == cur.get("data." + k[len("eval_data."):], "<absent>"):
>             continue                                              # eval cfg = the v2 training data cfg except the keys shown
>         if a != b:
>             ok = any(k == x or (x.endswith(".") and k.startswith(x)) or k.startswith(x + ".") for x in CFG_ALLOWED)
>             rows.append(f"  {'ok ' if ok else 'BAD'} {k}: 21980 {a} -> v2 {b}")
>             if not ok:
>                 bad.append(k)
>     log("[cfg-diff] resolved config vs 21980 (" + CFG["ref_cfg"] + "):\n" + "\n".join(rows))
>     assert not bad, ("config differs from 21980 outside the allowed keys", bad)
> 
