[Unit]
Description=Rosie finishing SFT duplex inference on two GPUs
After=network-online.target

[Service]
Type=simple
User=param
Group=param
WorkingDirectory=/home/param/pose-runs/opd-next-web-20261030/srv
ExecStart=/bin/bash /home/param/pose-runs/opd-next-web-20261030/ops/wait-backend.sh
Restart=on-failure
RestartSec=15
KillMode=control-group
TimeoutStopSec=45
StandardOutput=append:/home/param/pose-runs/opd-next-web-20261030/logs/backend.log
StandardError=append:/home/param/pose-runs/opd-next-web-20261030/logs/backend.log

[Install]
WantedBy=multi-user.target
