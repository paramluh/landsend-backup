+def s2p_mode(v):
+    """pose-s2p (10-27, user: "speech now conditions pose also"): PPM_S2P / cfg value -> None (off: no module, no key, today's maths), 'full'
+    (all 32 speech codebooks) or 'cb0' (speech cb0 only)."""
+    v = str(v if v is not None else "0").strip().lower()
+    if v in ("", "0", "off", "none", "false"):
+        return None
+    if v in ("1", "full", "on", "true"):
+        return "full"
+    assert v == "cb0", ("PPM_S2P must be 0 | 1 | full | cb0", v)
+    return "cb0"
+
