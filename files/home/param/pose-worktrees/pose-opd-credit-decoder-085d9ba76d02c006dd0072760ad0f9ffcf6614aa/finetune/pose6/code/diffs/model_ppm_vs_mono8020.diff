+class S2PEmb(nn.Module):
+    """pose-s2p: the pose tower's NEW input term at T = sum over the speech codebooks used of a per-code row (= a linear map of the one-hot
+    speech codes of the SAME position T, i.e. channel B's Mimi codes of the very frame whose pose cb0 is predicted at T). Weight ZERO at init
+    (the table IS the term's output projection): the tower input is bit-identical to today's at step 0 and every used row gets a non-zero
+    gradient from step 0. 'full' = all 32 codebooks (32 x 2048 rows, global ids = code + 2048 c), 'cb0' = cb0 only (2048 rows). -1 = no
+    speech codes at T (system block outside the voice clip, conversation frames 0, 1, text rows) -> 0 (H2.code_feedback)."""
+
+    def __init__(self, H, mode):
+        super().__init__()
+        assert mode in ("full", "cb0"), mode
+        self.mode = mode
+        self.weight = nn.Parameter(torch.empty((DEPTH if mode == "full" else 1) * CBS, H))
+
+    def forward(self, depth):
+        return H2.code_feedback(depth if self.mode == "full" else depth[..., :1], self.weight)
+
