+        else
+          note "ALERT: hang on $J but no COMPLETE save on all hosts >= $MIN_STEP (scan '${s}'); NOT cancelling"; sleep_s=600
+        fi
+      fi
+    fi
+  fi
+  [ "$ONESHOT" = 1 ] && exit 0
+  sleep "$sleep_s"
+done
