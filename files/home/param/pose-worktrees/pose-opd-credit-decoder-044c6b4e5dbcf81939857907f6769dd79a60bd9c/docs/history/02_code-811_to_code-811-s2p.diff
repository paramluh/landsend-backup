+def g0_problem(clip):
+    """'' if g0_feat can use the clip, else why not ('missing field <f>' / 'frame0_ok false' / 'bad value ...'); audit NIT: never silent."""
+    miss = [k for k in G0_FIELDS if k not in clip or clip[k] is None]
