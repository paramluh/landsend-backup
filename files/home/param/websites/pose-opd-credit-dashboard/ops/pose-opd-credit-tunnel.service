[Unit]
Description=Cloudflare tunnel for the pose credit dashboard on landsend-0
After=network-online.target pose-opd-credit-dashboard.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/param/websites/pose-opd-credit-dashboard
ExecStart=/usr/bin/python3 /home/param/websites/pose-opd-credit-dashboard/tunnel.py --port 9236
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
