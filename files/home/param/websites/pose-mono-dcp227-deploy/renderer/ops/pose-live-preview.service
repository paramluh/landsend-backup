[Unit]
Description=Pose inference live decoded skeleton preview
After=network.target
[Service]
Type=simple
WorkingDirectory=/home/param/websites/pose-renderer
Environment=OMP_NUM_THREADS=2
Environment=HF_HUB_OFFLINE=1
ExecStart=/home/param/pose-repo/.venv/bin/python -u /home/param/websites/pose-renderer/live_pose.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/param/runs/pose-runs/pose-sites-20261030/render/live-preview.log
StandardError=append:/home/param/runs/pose-runs/pose-sites-20261030/render/live-preview.log
[Install]
WantedBy=default.target
